# Environment variables for Kasir Pintar
# Salin file ini menjadi .env dan isi nilai sesuai setup lokal Anda.

# Koneksi MySQL — sesuaikan user, password, host, port, dan nama database
# Contoh XAMPP default (root tanpa password, port 3306):
#   DATABASE_URL="mysql://root@localhost:3306/kasir_pintar"
DATABASE_URL="mysql://root@localhost:3306/kasir_pintar"

# Secret untuk Auth.js (jalankan: openssl rand -base64 32)
AUTH_SECRET="ganti-dengan-random-secret-panjang"

# URL dasar aplikasi (untuk development)
AUTH_URL="http://localhost:3000"

# Optional: gunakan untuk seeding user admin awal
SEED_ADMIN_NAME="Administrator"
SEED_ADMIN_EMAIL="admin@kasirpintar.app"
SEED_ADMIN_PASSWORD="admin12345"